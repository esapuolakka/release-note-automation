# Copy to .env and `export $(grep -v '^#' .env | xargs)` for local runs. Never commit .env.

# GitHub (read access to the source repo; needed for private repos and higher rate limits)
GITHUB_TOKEN=

# LLM (the key for the provider you selected)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email target (SMTP)
SMTP_USER=
SMTP_PASSWORD=

# Slack target
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Optional overrides of release-notes.config.json
# RN_REPOSITORY=owner/repo
# RN_BRANCH=main
# RN_TAG=v1.2.3
# RN_TARGETS=email,slack
# RN_EMAIL_TO=a@example.com,b@example.com
# SMTP_HOST=smtp.gmail.com
# RN_LLM_PROVIDER=anthropic
# RN_LLM_MODEL=
